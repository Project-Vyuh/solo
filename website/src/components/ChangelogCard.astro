---
import { Icon } from 'astro-icon/components';
import { url } from '../lib/utils';

interface Props {
  id: string;
  version: string;
  title: string;
  date: string;
  summary: string;
  categories: string[];
}

const { id, version, title, date, summary, categories } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<a
  href={url(`/changelog/${id}/`)}
  class="group block p-5 rounded-lg border border-line bg-card hover:border-accent/50 transition-all"
>
  <div class="flex items-start justify-between gap-4">
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-3 mb-2">
        <span class="text-xs font-mono text-accent">{version}</span>
        <span class="text-xs text-muted-foreground">{formattedDate}</span>
      </div>
      <h3 class="text-base font-semibold text-card-foreground mb-1.5">
        {title}
      </h3>
      <p class="text-sm text-muted-foreground leading-relaxed line-clamp-2">
        {summary}
      </p>
      <div class="flex gap-2 mt-3">
        {categories.map((cat) => (
          <span class="text-xs font-medium px-2 py-0.5 rounded-full border border-line text-muted-foreground">
            {cat}
          </span>
        ))}
      </div>
    </div>
    <Icon
      name="lucide:arrow-right"
      class="w-4 h-4 text-muted-foreground group-hover:text-accent transition-colors flex-shrink-0 mt-1"
    />
  </div>
</a>
