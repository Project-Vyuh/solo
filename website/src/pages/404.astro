---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Icon } from 'astro-icon/components';
import { url } from '../lib/utils';
---

<Base title="Not Found | Solo">
  <Header />
  <main class="px-6 pt-32 pb-24">
    <div class="mx-auto max-w-prose text-center">
      <p class="text-7xl font-bold text-muted-foreground/30 mb-4">404</p>
      <h1 class="text-2xl font-semibold text-foreground mb-3">
        Page not found
      </h1>
      <p class="text-muted-foreground mb-8">
        The page you are looking for does not exist.
      </p>
      <a
        href={url('/')}
        class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium rounded-lg border border-line text-foreground hover:bg-muted transition-colors"
      >
        <Icon name="lucide:arrow-left" class="w-4 h-4" />
        Back to home
      </a>
    </div>
  </main>
  <Footer />
</Base>
