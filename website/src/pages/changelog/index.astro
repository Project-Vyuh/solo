---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ChangelogCard from '../../components/ChangelogCard.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import { url } from '../../lib/utils';

const allEntries = await getCollection('changelog');
const entries = allEntries.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<Base title="Changelog | Solo">
  <Header />
  <main class="px-6 pt-32 pb-24">
    <div class="mx-auto max-w-prose">
      <a
        href={url('/')}
        class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-accent transition-colors mb-10"
      >
        <Icon name="lucide:arrow-left" class="w-4 h-4" />
        Home
      </a>

      <h1 class="text-3xl font-bold tracking-tight text-foreground mb-8">
        Changelog
      </h1>

      {entries.length > 0 ? (
        <div class="space-y-3">
          {entries.map((entry) => (
            <ChangelogCard
              id={entry.id}
              version={entry.data.version}
              title={entry.data.title}
              date={entry.data.date}
              summary={entry.data.summary}
              categories={entry.data.categories}
            />
          ))}
        </div>
      ) : (
        <div class="text-center py-12 border border-dashed border-line rounded-lg">
          <p class="text-muted-foreground text-sm">
            No changelog entries yet. The first release is coming soon.
          </p>
        </div>
      )}
    </div>
  </main>
  <Footer />
</Base>
