<?xml version="1.0" encoding="utf-8"?>
<!--
  Solo network security policy.

  This is the OS-level companion to dev.projectvyuh.solo.core.privacy.NetworkGuard.
  NetworkGuard restricts the destination set; this file restricts the protocol
  and trust chain for whatever requests do go out.

  Policy:
    - cleartextTrafficPermitted=false : refuse plain HTTP everywhere, no exceptions.
    - trust-anchors src="system"      : trust only system CAs. User-installed CAs
                                         (e.g. corporate or interception certs) are
                                         NOT trusted by Solo. This blocks the
                                         "user installed a rogue cert" MITM path.

  Note that on API 28+ Android already defaults cleartext to false, but stating
  it explicitly here means the policy is auditable from source rather than
  inferred from the targetSdk.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
